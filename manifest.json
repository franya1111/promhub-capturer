{
  "manifest_version": 3,
  "name": "PromHub Capturer — шаблони для promv2",
  "short_name": "PromHub Capturer",
  "version": "1.0.0",
  "description": "Автоматично перехоплює запити my.prom.ua (редагування товарів, оплата, чек) і зберігає їх як шаблони для вашої панелі promv2.",
  "author": "PromHub",
  "homepage_url": "https://promv2.franya.dev/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "webRequest",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://my.prom.ua/*",
    "https://my.bigl.ua/*",
    "https://my.satu.kz/*",
    "https://my.deal.by/*",
    "https://promv2.franya.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://my.prom.ua/*", "https://my.bigl.ua/*", "https://my.satu.kz/*", "https://my.deal.by/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromHub Capturer — налаштування",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "overlay.css", "overlay.js"],
      "matches": ["https://my.prom.ua/*", "https://my.bigl.ua/*", "https://my.satu.kz/*", "https://my.deal.by/*"]
    }
  ]
}
